# Copy this file to .env and fill in real values. .env is gitignored so
# secrets never get committed.

DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"
MONGODB_URI="mongodb+srv://<user>:<password>@<host>/<database>"

# Hackathon "Product Search API" — the real backend for the catalogue, orders,
# and account balance. Credentials issued by the hackathon organizers.
SHOP_API_URL="https://day1.training.cognitivo.com.au"
SHOP_API_USER_ID="your-participant-user-id"
SHOP_API_KEY="your-participant-api-key"

# Azure OpenAI (not wired into any feature yet — see conversation).
AZURE_OPENAI_ENDPOINT="https://<your-resource>.api.cognitive.microsoft.com/"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT="your-deployment-name"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
